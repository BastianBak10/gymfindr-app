# Kopiér til .env og udfyld værdierne. .env må aldrig committes.
# Firebase-konsollen → Projektindstillinger → Generelt → web-app.
# Database-URL'en står øverst på Realtime Database-siden.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_DB_URL=

# Spørg Ronnie: API-nøgle fra platform.openai.com (giv projektet en lav forbrugsgrænse)
EXPO_PUBLIC_OPENAI_API_KEY=

# Valgfri: adresseopslag via Dataforsyningen (dataforsyningen.dk/user)
# EXPO_PUBLIC_DATAFORSYNINGEN_TOKEN=

# Valgfri: udfyldes efter eas init, hvis projectId ikke ligger i app.json
# EXPO_PUBLIC_EAS_PROJECT_ID=
